@model CafeBliss.Models.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login - Cafe Bliss</title>

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Google Font -->

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-image: url('/Images/Login-Background.jpeg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            height: 100vh;
            overflow: hidden;
        }

        /* Dark Overlay */

        .overlay {
            width: 100%;
            height: 100vh;
            background-color: rgba(0,0,0,0.45);
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding-right: 80px;
        }

        /* Logo */

        .logo {
            position: absolute;
            top: 15px;
            left: 80px;
            color: white;
            font-size: 38px;
            font-weight: bold;
        }

            .logo span {
                color: #c58b54;
            }

        /* Login Card */

        .login-box {
            width: 450px;
            background-color: white;
            padding: 50px 40px;
            border-radius: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .login-title {
            font-size: 45px;
            font-weight: bold;
            color: #2b1700;
            margin-bottom: 10px;
        }

        .login-subtitle {
            color: gray;
            margin-bottom: 35px;
            font-size: 17px;
        }

        .form-label {
            font-weight: 500;
            color: #2b1700;
            margin-bottom: 8px;
        }

        .form-control {
            height: 58px;
            border-radius: 12px;
            border: none;
            background-color: #f2e7dc;
            padding-left: 18px;
            margin-bottom: 22px;
            font-size: 16px;
        }

            .form-control:focus {
                box-shadow: none;
                background-color: #ead8c7;
            }

        .login-btn {
            width: 100%;
            height: 58px;
            border: none;
            border-radius: 12px;
            background-color: #2b1700;
            color: white;
            font-size: 18px;
            font-weight: 600;
            transition: 0.4s;
        }

            .login-btn:hover {
                background-color: #a56f3f;
            }

        .bottom-text {
            text-align: center;
            margin-top: 25px;
            color: gray;
        }

            .bottom-text a {
                color: #c58b54;
                text-decoration: none;
                font-weight: 600;
            }

        .error-message {
            text-align: center;
            color: red;
            margin-top: 15px;
            font-weight: 500;
        }

        /* Responsive */

        @@media(max-width:992px) {

            .overlay {
                justify-content: center;
                padding-right: 0;
                padding: 20px;
            }

            .login-box {
                width: 100%;
                max-width: 420px;
            }

            .logo {
                left: 20px;
                font-size: 30px;
            }
        }

    </style>

</head>

<body>

    <!-- Logo -->

    <div class="logo">

        <span> <img src="~/Images/Cafelogo.png" alt="Alternate Text" width="170"/> </span>

    </div>

    <!-- Overlay -->

    <div class="overlay">

        <!-- Login Card -->

        <div class="login-box">

            <h1 class="login-title">
                Welcome Back
            </h1>

            <p class="login-subtitle">
                Login to continue your coffee journey
            </p>

            @* <form method="post"
                  asp-controller="Login"
                  asp-action="Login">

                <label class="form-label">
                    Email Address
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Enter your email" />

                <label class="form-label">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Enter your password" />

                <button type="submit" class="login-btn">
                    Login
                </button>

            </form> *@



            <form method="post" action="/Login/Login">

                <label class="form-label">
                    Email Address
                </label>

                <input type="text"
                       name="Email"
                       class="form-control"
                       placeholder="Enter your email" />

                <label class="form-label">
                    Password
                </label>

                <input type="password"
                       name="Password"
                       class="form-control"
                       placeholder="Enter your password" />

                <button type="submit" class="login-btn">
                    Login
                </button>

            </form>





            @if (ViewBag.Message != null)
            {
                <div class="error-message">
                    @ViewBag.Message
                </div>
            }

            <div class="bottom-text">

                Don't have an account?

                <a href="#">
                    Register
                </a>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>