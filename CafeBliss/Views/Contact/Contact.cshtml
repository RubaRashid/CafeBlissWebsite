
@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

    body {
        background-color: #f8f5f2;
        font-family: 'Poppins', sans-serif;
    }

    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/Images/ContactMain.png');
        background-size: cover;
        background-position: center;
        height: 350px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: white;
    }

        .hero-section h1 {
            font-size: 70px;
            font-weight: bold;
            font-family: cursive;
        }

        .hero-section p {
            font-size: 20px;
            margin-top: 10px;
        }

    .section-title {
        color: #8B5E3C;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .main-heading {
        font-size: 50px;
        font-weight: bold;
        color: #2d1b12;
        margin-bottom: 25px;
    }

    .contact-text {
        color: #555;
        line-height: 32px;
        font-size: 18px;
    }

    .coffee-img {
        width: 100%;
        border-radius: 20px;
        object-fit: cover;
    }

    .info-box {
        background: #fff;
        border-radius: 15px;
        padding: 30px 20px;
        text-align: center;
        box-shadow: 0px 5px 20px rgba(0,0,0,0.08);
        transition: 0.3s;
        height: 100%;
    }

        .info-box:hover {
            transform: translateY(-5px);
        }

        .info-box h5 {
            color: #2d1b12;
            margin-top: 15px;
            font-weight: 600;
        }

        .info-box p {
            color: #666;
            margin-top: 10px;
        }

    .icon-circle {
        width: 70px;
        height: 70px;
        background: #8B5E3C;
        color: white;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: auto;
        font-size: 28px;
    }

    .contact-form {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0px 5px 20px rgba(0,0,0,0.08);
    }

        .contact-form h2 {
            color: #2d1b12;
            font-weight: bold;
            margin-bottom: 25px;
        }

    .form-control {
        height: 55px;
        border-radius: 10px;
        margin-bottom: 20px;
        border: 1px solid #ddd;
    }

    textarea.form-control {
        height: 150px;
        resize: none;
    }

    .btn-send {
        background: #8B5E3C;
        color: white;
        padding: 14px 35px;
        border: none;
        border-radius: 10px;
        font-size: 18px;
        transition: 0.3s;
    }

        .btn-send:hover {
            background: #6f472d;
        }

    .map-section iframe {
        width: 100%;
        height: 100%;
        min-height: 590px;
        border: 0;
        border-radius: 20px;
    }

</style>

<!-- HERO SECTION -->

<section class="hero-section">
    <div>
        <h1>Contact Us</h1>
        <p>We’d love to hear from you. Visit us or send us a message.</p>
    </div>
</section>

<!-- ABOUT CONTACT -->

<div class="container py-5">

    <div class="row align-items-center g-5">

        <div class="col-lg-6">

            <h5 class="section-title">Get In Touch</h5>

            <h1 class="main-heading">
                We Are Here <br />
                To Help You
            </h1>

            <p class="contact-text">
                Have a question, feedback, or want to reserve a table?
                Our team at Cafe Bliss is always ready to help you.
                Feel free to contact us anytime and enjoy the best café
                experience with delicious coffee and fresh bakery items.
            </p>

        </div>

        <div class="col-lg-6">

            <img src="~/Images/ContactUs1.png"
                 class="coffee-img"
                 alt="Coffee Image">

        </div>

    </div>

</div>

<!-- CONTACT INFO -->

<div class="container pb-5">

    <div class="row g-4">

        <div class="col-md-3">

            <div class="info-box">

                <div class="icon-circle">📍</div>

                <h5>Location</h5>

                <p>
                    Cafe Bliss <br />
                    Karachi, Pakistan
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="info-box">

                <div class="icon-circle">📞</div>

                <h5>Phone</h5>

                <p>
                    +92 300 1234567 <br />
                    +92 321 9876543
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="info-box">

                <div class="icon-circle">📧</div>

                <h5>Email</h5>

                <p>
                    info@cafebliss.com <br />
                    support@cafebliss.com
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="info-box">

                <div class="icon-circle">⏰</div>

                <h5>Opening Hours</h5>

                <p>
                    Mon - Fri : 9 AM - 10 PM <br />
                    Sat - Sun : 10 AM - 11 PM
                </p>

            </div>

        </div>

    </div>

</div>

<!-- CONTACT FORM + MAP -->

<div class="container pb-5">

    <div class="row g-5">

        <!-- FORM -->

        <div class="col-lg-6">

            <div class="contact-form">

                <h2>Send Us A Message</h2>

                <form>

                    <input type="text"
                           class="form-control"
                           placeholder="Your Name">

                    <input type="email"
                           class="form-control"
                           placeholder="Your Email">

                    <input type="text"
                           class="form-control"
                           placeholder="Subject">

                    <textarea class="form-control"
                              placeholder="Your Message"></textarea>

                    <button class="btn-send">
                        Send Message
                    </button>

                </form>

            </div>

        </div>

        <!-- MAP -->

        <div class="col-lg-6">

            <div class="map-section">

                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3620.248871049207!2d67.001136!3d24.860734!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3eb33e6d1f1f1f1f%3A0x1234567890abcdef!2sKarachi!5e0!3m2!1sen!2s!4v1710000000000">
                </iframe>

            </div>

        </div>

    </div>

</div>