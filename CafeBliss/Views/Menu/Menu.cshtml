@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Coffee Menu";
}

 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

    body {
        background-color: #ffffff;
        font-family: 'Poppins', sans-serif;
    }

    .category-title {
        font-size: 40px;
        font-weight: 700;
        color: #3e2723;
        margin-bottom: 30px;
        border-left: 5px solid #3e2723;
        padding-left: 15px;
    }

    .menu-title {
        text-align: center;
        margin-top: 50px;
        margin-bottom: 50px;
        font-size: 42px;
        font-weight: 700;
        color: #3e2723;
        letter-spacing: 1px;
    }

    .coffee-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #eee;
        transition: 0.25s ease;
        height: 100%;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

        .coffee-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

    .coffee-image {
        width: 100%;
        height: 240px;
        object-fit: cover;
    }

    .card-body-custom {
        padding: 22px;
    }

    .coffee-name {
        font-size: 24px;
        font-weight: 700;
        color: #3e2723;
        margin-bottom: 10px;
    }

    .coffee-description {
        font-size: 15px;
        color: #5d4037;
        line-height: 1.6;
        margin-bottom: 18px;
    }

    .bottom-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .coffee-price {
        font-size: 22px;
        font-weight: 700;
        color: #3e2723;
    }

    .order-btn {
        background-color: #3e2723;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 500;
        transition: 0.2s ease;
    }

        .order-btn:hover {
            background-color: #5d4037;
        }

</style>

