    <h1 class="category-title mt-5">Snacks</h1>

    <div class="row">

        @foreach (var item in Model.Where(x => x.Category == "Snacks"))
        {
            <div class="col-lg-3 mb-4">

                <div class="coffee-card">

                    <img src="@item.ImageUrl" class="coffee-image" />

                    <div class="card-body-custom">

                        <h3 class="coffee-name">
                            @item.Name
                        </h3>

                        <p class="coffee-description">
                            @item.Description
                        </p>

                        <div class="bottom-section">

                            <div class="coffee-price">
