@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Custom Variables and Base Styles */
    :root {
        --primary-brown: #a87445;
        --dark-bg: #150c07;
        --light-bg: #faf8f5;
        --text-dark: #3e2723;
        --text-muted: #795548;
    }

    body {
        background-color: var(--light-bg);
        color: var(--text-dark);
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* Typography & Utilities */
    .script-font {
        font-family: 'Brush Script MT', 'Lucida Handwriting', cursive;
        color: var(--primary-brown);
        font-size: 2rem;
        margin-bottom: 0;
    }

    .text-primary-brown {
        color: var(--primary-brown) !important;
    }

    .text-muted-custom {
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    /* Buttons */
    .btn-brown {
        background-color: var(--primary-brown);
        color: white;
        border: none;
        padding: 10px 28px;
        border-radius: 6px;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-brown:hover {
            background-color: #8c5d35;
            color: white;
        }

    .btn-outline-play {
        background: transparent;
        color: white;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .btn-outline-play .play-icon {
            border: 2px solid white;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-left: 3px; /* visual center for play triangle */
        }

    /* Section Styles */
    .hero-section {
        background-color: var(--dark-bg);
        color: white;
        padding: 80px 0;
    }

    .section-title {
        font-weight: 700;
        text-align: center;
        margin-bottom: 30px;
        font-size: 2.2rem;
    }

    .separator {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 40px;
    }

        .separator::before, .separator::after {
            content: "";
            height: 1px;
            width: 40px;
            background-color: var(--primary-brown);
            margin: 0 15px;
        }

    /* Cards */
    .drink-card {
        border: none;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        text-align: center;
        padding-bottom: 20px;
        background-color: white;
        height: 100%;
    }

        .drink-card img {
            border-radius: 8px 8px 0 0;
            object-fit: cover;
            height: 200px;
            width: 100%;
        }

    .price-tag {
        color: var(--primary-brown);
        font-weight: 700;
        font-size: 1.2rem;
        margin-top: 10px;
    }

    /* Special Offer */
    .special-offer-banner {
        background-color: var(--dark-bg);
        color: white;
        border-radius: 12px;
        padding: 50px;
        margin-top: 60px;
        margin-bottom: 60px;
    }

    /* Features */
    .feature-box {
        text-align: center;
        padding: 20px;
        background: white;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.03);
        height: 100%;
    }

    .feature-icon {
        font-size: 1.8rem;
        color: var(--primary-brown);
        margin-bottom: 15px;
    }

    /* Testimonials */
    .testimonial-card {
        background: white;
        border: none;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        height: 100%;
    }

    .avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        margin-right: 15px;
    }

    .stars {
        color: #ffc107;
        font-size: 0.9rem;
    }
</style>

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <p class="script-font">Start your day with</p>
                <h1 class="display-3 fw-bold mb-0">Good Coffee</h1>
                <h1 class="display-3 fw-bold mb-4">Good Mood</h1>
                <p class="lead mb-4 text-light" style="font-size: 1.1rem; opacity: 0.9;">
                    Freshly brewed coffee made with love.<br>
                    Come, relax and enjoy the best coffee in town.
                </p>
                <div class="d-flex align-items-center gap-3">
                    <a href="#" class="btn btn-brown">Explore Menu</a>
                    <button class="btn btn-outline-play">
                        <span class="play-icon">&#9658;</span> Watch Video
                    </button>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="~/Images/heroMVC.jpeg" alt="Coffee Cup" class="img-fluid" style="max-width: 80%;">
            </div>
        </div>
    </div>
</section>

